<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
      <PackageReference Include="InkCanvas.PluginSdk" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Calligraphy.Application\Calligraphy.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="View\ApplicationView.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Resources\Images\Buttons\Grass-Buttons-return.png" />
      <Resource Include="Resources\Images\Buttons\Grass-Buttons-house.png" />
      <Resource Include="Resources\Images\Buttons\Grass-Buttons-arrow2.png" />
      <Resource Include="Resources\Images\Buttons\Pressed\Grass-Buttons-pressed-return.png" />
      <Resource Include="Resources\Images\Buttons\Pressed\Grass-Buttons-pressed-house.png" />
      <Resource Include="Resources\Images\Buttons\Pressed\Grass-Buttons-pressed-arrow2.png" />
    </ItemGroup>

</Project>
