<UserControl x:Class="Calligraphy.Presentation.Views.ShapeDrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:ShapeDrawViewModel}">

    <Viewbox Stretch="Uniform">
        <Grid Height="800" Width="1200">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Margin="0, 50, 0, 0">
                <Border Width="520" Height="520"
                        Background="{StaticResource SecondaryColor}"
                        CornerRadius="10"
                        Margin="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" />
                    </Border.Effect>
                    <Border
                        Background="White"
                        Width="500"
                        Height="500"
                        Margin="0"
                        CornerRadius="10">
                        <Canvas x:Name="TemplateCanvas" />
                    </Border>
                </Border>

                <Border Width="520" Height="520"
                        Background="{StaticResource SecondaryColor}"
                        CornerRadius="10"
                        Margin="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" />
                    </Border.Effect>
                    <Border
                        Background="White"
                        Width="500"
                        Height="500"
                        Margin="0"
                        CornerRadius="10">
                        <controls:InkCanvasControl x:Name="InkCanvas" />
                    </Border>
                </Border>
            </StackPanel>

            <Button
                Grid.Row="1"
                Command="{Binding CheckCommand}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,40"
                Cursor="Pen"
                IsEnabled="{Binding IsClickable}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Image x:Name="ButtonImage"
                                   Source="/Resources/Assets/Images/Buttons/Grass-Buttons-v.png"
                                   Width="100"
                                   Stretch="Uniform" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonImage" Property="Source"
                                        Value="/Resources/Assets/Images/Buttons/Pressed/Grass-Buttons-pressed-v.png" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <controls:GameResultPopup
                x:Name="ResultPopup"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <controls:MascotFeedbackControl
                x:Name="MascotFeedback"
                Grid.Row="0"
                Grid.RowSpan="2" />

        </Grid>
    </Viewbox>
</UserControl>