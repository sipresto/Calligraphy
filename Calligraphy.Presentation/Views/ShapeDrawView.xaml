<UserControl x:Class="Calligraphy.Presentation.Views.ShapeDrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="2"
                Margin="10">
            <Canvas x:Name="TemplateCanvas"
                    Background="White"/>
        </Border>

        <StackPanel Grid.Column="1">

            <Border BorderBrush="Black"
                    BorderThickness="2"
                    Margin="10">
                <Canvas x:Name="DrawCanvas"
                        Background="White"
                        Height="350"
                        MouseDown="DrawCanvas_MouseDown"
                        MouseMove="DrawCanvas_MouseMove"
                        MouseUp="DrawCanvas_MouseUp"/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">
                <Button Content="Reset"
                        Width="100"
                        Margin="10"
                        Click="Reset_Click"/>
                <Button Content="Check"
                        Width="100"
                        Margin="10"
                        Click="Check_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
