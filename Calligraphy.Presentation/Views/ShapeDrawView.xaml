<UserControl x:Class="Calligraphy.Presentation.Views.ShapeDrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:ShapeDrawViewModel}">
    
    <Viewbox Stretch="Uniform">
        <Grid Height="800" Width="1200">
            
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="Black"
                BorderThickness="2"
                Margin="10"
                Width="500"
                Height="500">
            <Canvas x:Name="TemplateCanvas"
                    Background="White"/>
        </Border>

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">

            <Border BorderBrush="Black"
                    BorderThickness="2"
                    Margin="10"
                    Width="500"
                    Height="500">
                <controls:InkCanvasControl
                    x:Name="InkCanvas" />
            </Border>
        </StackPanel>
            
            <StackPanel Grid.Column="2"
                        Orientation="Vertical"
                        VerticalAlignment="Center">
                <Button Content="Check"
                        Width="100"
                        Margin="10"
                        Command="{Binding CheckCommand}"/>
            </StackPanel>

            <controls:GameResultPopup
                x:Name="ResultPopup"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            
            <controls:MascotFeedbackControl
                x:Name="MascotFeedback"
                Grid.Column="0"
                Grid.ColumnSpan="3"/>

        </Grid>
    </Viewbox>
</UserControl>
