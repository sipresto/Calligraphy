<UserControl x:Class="Calligraphy.Presentation.Views.ShapeDrawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             xmlns:styles="clr-namespace:Calligraphy.Presentation.Styles"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:ShapeDrawViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    
    <Viewbox Stretch="Uniform">
        <Grid Height="800" Width="1200">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Margin="0, 50, 0, 0">
                <Border Width="520" Height="520"
                        Background="{StaticResource SecondaryColor}"
                        CornerRadius="10"
                        Margin="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" />
                    </Border.Effect>
                    <Border
                        Background="White"
                        Width="500"
                        Height="500"
                        Margin="0"
                        CornerRadius="10">
                        <Canvas x:Name="TemplateCanvas" />
                    </Border>
                </Border>

                <Border Width="520" Height="520"
                        Background="{StaticResource SecondaryColor}"
                        CornerRadius="10"
                        Margin="30">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" />
                    </Border.Effect>
                    <Border
                        Background="White"
                        Width="500"
                        Height="500"
                        Margin="0"
                        CornerRadius="10">
                        <controls:InkCanvasControl x:Name="InkCanvas"
                                                   IsDrawingEnabled="{Binding IsDrawingEnabled}"/>
                    </Border>
                </Border>
            </StackPanel>
            
            <Button Grid.Row="1"
                    Command="{Binding CheckCommand}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,40"
                    Width="100"
                    IsEnabled="{Binding IsClickable}"
                    Style="{StaticResource ImageButtonStyle}"
                    styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Grass-Buttons-v.png"
                    styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Grass-Buttons-pressed-v.png" />

            <Button
                Grid.Row="0"
                Command="{Binding PauseCommand}"
                Width="70"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Style="{StaticResource ImageButtonStyle}"
                styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/pause-button.png"
                styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/pause-button.png"
                Visibility="{Binding IsPauseButtonVisible, Converter={StaticResource BoolToVisibility}}" />
            
            <controls:GameResultPopup
                x:Name="ResultPopup"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            
            <controls:PausePopup
                x:Name="PausePopup"
                Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <controls:MascotFeedbackControl
                Grid.Row="0"
                Grid.RowSpan="2" />

        </Grid>
    </Viewbox>
</UserControl>