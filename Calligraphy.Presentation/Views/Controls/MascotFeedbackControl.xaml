<UserControl x:Class="Calligraphy.Presentation.Views.Controls.MascotFeedbackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    
    <Grid
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Visibility="{Binding IsGameResultVisible, Converter={StaticResource BoolToVisibility}}">

        <StackPanel>
            <Grid HorizontalAlignment="Right"
                  Margin="10">
                <Polygon Points="0,0 20,20 0,40"
                         Fill="White"
                         Stroke="Black"
                         StrokeThickness="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,-10,30,-10"/>
                
                <Border Background="White"
                        BorderBrush="Black"
                        BorderThickness="2"
                        CornerRadius="30"
                        Padding="20"
                        MaxWidth="400">
                    <TextBlock Text="{Binding GameResult.FeedbackMessage}"
                               TextWrapping="Wrap"
                               FontSize="36"
                               Foreground="Black"/>
                </Border>
            </Grid>

            <Image Source="/Resources/Assets/Images/Mascot/mascot-bear-1.png"
                   Width="300"
                   Height="300"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"/>
        </StackPanel>
    </Grid>
</UserControl>
