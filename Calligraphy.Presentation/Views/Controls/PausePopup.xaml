<UserControl x:Class="Calligraphy.Presentation.Views.Controls.PausePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:styles="clr-namespace:Calligraphy.Presentation.Styles"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border
        CornerRadius="12"
        Padding="20"
        Width="400"
        Height="300"
        Visibility="{Binding IsPauseVisible, Converter={StaticResource BoolToVisibility}}">
        <Border.Background>
            <ImageBrush ImageSource="/Resources/Assets/Images/TextBars/Square.png"
                        Stretch="Fill" />
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Gepauzeerd"
                FontSize="40"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,10"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">

                <Button Command="{Binding ResumeCommand}"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource ImageButtonStyle}"
                        styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-arrow.png"
                        styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-arrow.png" />

                <Button Command="{Binding RestartCommand}"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource ImageButtonStyle}"
                        styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-return.png"
                        styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-return.png" />

                <Button Command="{Binding MenuCommand}"
                        Width="100"
                        Style="{StaticResource ImageButtonStyle}"
                        styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-house.png"
                        styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-house.png" />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
