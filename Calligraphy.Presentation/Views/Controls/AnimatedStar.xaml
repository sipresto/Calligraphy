<UserControl x:Class="Calligraphy.Presentation.Views.Controls.AnimatedStar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="Root">

    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">
            <Grid Background="Transparent">
                <Image Source="/Resources/Assets/Images/Icons/Empty-star.png" Stretch="Uniform" />

                <Image x:Name="FilledStar" 
                       Source="/Resources/Assets/Images/Icons/Star.png" 
                       Stretch="Uniform" 
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="StarScale" ScaleX="0" ScaleY="0" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFilled, ElementName=Root}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StarScale" 
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase Amplitude="1" EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="StarScale" 
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase Amplitude="1" EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StarScale" 
                                                 Storyboard.TargetProperty="ScaleX" 
                                                 To="0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetName="StarScale" 
                                                 Storyboard.TargetProperty="ScaleY" 
                                                 To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>