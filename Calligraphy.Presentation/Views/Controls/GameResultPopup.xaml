<UserControl x:Class="Calligraphy.Presentation.Views.Controls.GameResultPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:converters="clr-namespace:Calligraphy.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        Background="LightBlue"
        CornerRadius="12"
        Padding="20"
        Width="600"
        Height="400"
        Visibility="{Binding IsGameResultVisible, Converter={StaticResource BoolToVisibility}}">


        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

                    <local:AnimatedStar x:Name="Star1" Margin="0,0,10,0" />
                    <local:AnimatedStar x:Name="Star2" />
                    <local:AnimatedStar x:Name="Star3" Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock
                    Text="{Binding GameResult.Score, StringFormat=Score: {0}}"
                    FontSize="30"
                    FontWeight="Bold"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding GameResult.Score, Converter={StaticResource NullableToVisibilityConverter}}" />

                <TextBlock
                    Text="{Binding GameResult.Time, StringFormat=Tijd: {0}s}"
                    FontSize="30"
                    FontWeight="Bold"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding GameResult.Time, Converter={StaticResource NullableToVisibilityConverter}}" />
            </StackPanel>

            
            <StackPanel 
                Grid.Row="1"
                Margin="0,0,0,10"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
                
                <Button
                    Command="{Binding RestartCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,0,10,0"
                    Cursor="Hand" >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image x:Name="ButtonImage"
                                       Source="/Resources/Images/Buttons/Grass-Buttons-return.png"
                                       Width="100"
                                       Stretch="Uniform" />
                            </Grid>
            
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonImage" Property="Source" 
                                            Value="/Resources/Images/Buttons/Pressed/Grass-Buttons-pressed-return.png" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button
                    Command="{Binding MenuCommand}"
                    HorizontalAlignment="Center"
                    Cursor="Hand" >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image x:Name="ButtonImage"
                                       Source="/Resources/Images/Buttons/Grass-Buttons-house.png"
                                       Width="100"
                                       Stretch="Uniform" />
                            </Grid>
            
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonImage" Property="Source" 
                                            Value="/Resources/Images/Buttons/Pressed/Grass-Buttons-pressed-house.png" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button
                    Command="{Binding NextLevelCommand}"
                    HorizontalAlignment="Center"
                    Margin="10,0,0,0"
                    Cursor="Hand"
                    Visibility="{Binding HasNextLevel, Converter={StaticResource BoolToVisibility}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image x:Name="ButtonImage"
                                       Source="/Resources/Images/Buttons/Grass-Buttons-arrow2.png"
                                       Width="100"
                                       Stretch="Uniform" />
                            </Grid>
            
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonImage" Property="Source" 
                                            Value="/Resources/Images/Buttons/Pressed/Grass-Buttons-pressed-arrow2.png" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
            </StackPanel>

        </Grid>
    </Border>
</UserControl>