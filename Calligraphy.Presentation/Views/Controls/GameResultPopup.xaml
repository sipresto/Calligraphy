<UserControl x:Class="Calligraphy.Presentation.Views.Controls.GameResultPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:converters="clr-namespace:Calligraphy.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="450">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        BorderBrush="Blue"
        BorderThickness="3"
        Background="LightBlue"
        CornerRadius="12"
        Padding="20"
        Width="450"
        Height="300"
        Visibility="{Binding IsGameResultVisible, Converter={StaticResource BoolToVisibility}}">

        <StackPanel DataContext="{Binding GameResult}">
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,0">

                <local:AnimatedStar x:Name="Star1" Margin="0,0,10,0" />
                <local:AnimatedStar x:Name="Star2" />
                <local:AnimatedStar x:Name="Star3" Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock
                Text="{Binding Score, StringFormat=Score: {0}}"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding Score, Converter={StaticResource NullableToVisibilityConverter}}" />

            <TextBlock
                Text="{Binding Time, StringFormat=Tijd: {0}s}"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Visibility="{Binding Time, Converter={StaticResource NullableToVisibilityConverter}}" />

            <Button
                Content="Opnieuw"
                Margin="0,30,0,0"
                Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        </StackPanel>

    </Border>
</UserControl>