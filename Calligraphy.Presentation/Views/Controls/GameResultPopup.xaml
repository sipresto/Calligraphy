<UserControl x:Class="Calligraphy.Presentation.Views.Controls.GameResultPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:converters="clr-namespace:Calligraphy.Presentation.Converters"
             xmlns:styles="clr-namespace:Calligraphy.Presentation.Styles"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        CornerRadius="12"
        Padding="20"
        Width="600"
        Height="400"
        Visibility="{Binding IsGameResultVisible, Converter={StaticResource BoolToVisibility}}">
        <Border.Background>
            <ImageBrush ImageSource="/Resources/Assets/Images/TextBars/Square.png"
                        Stretch="Fill" />
        </Border.Background>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0">

                    <local:AnimatedStar x:Name="Star1" Margin="0,0,10,0" />
                    <local:AnimatedStar x:Name="Star2" />
                    <local:AnimatedStar x:Name="Star3" Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock
                    Text="{Binding GameResult.Score, StringFormat=Score: {0}}"
                    FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                    FontSize="30"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding GameResult.Score, Converter={StaticResource NullableToVisibilityConverter}}" />

                <TextBlock
                    Text="{Binding BestScore, StringFormat=Beste score: {0}}"
                    FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                    FontSize="30"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding BestScore, Converter={StaticResource NullableToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,10"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">

                <Button Command="{Binding RestartCommand}"
                        Width="100"
                        Margin="0,0,10,0"
                        Style="{StaticResource ImageButtonStyle}"
                        styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-return.png"
                        styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-return.png" />

                <Button Command="{Binding MenuCommand}"
                        Width="100"
                        Style="{StaticResource ImageButtonStyle}"
                        styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-house.png"
                        styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-house.png" />

                <Button Command="{Binding NextLevelCommand}"
                        Width="100"
                        Margin="10,0,0,0"
                        Visibility="{Binding HasNextLevel, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource ImageButtonStyle}"
                        styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-arrow2.png"
                        styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-arrow2.png" />

            </StackPanel>

        </Grid>
    </Border>
</UserControl>