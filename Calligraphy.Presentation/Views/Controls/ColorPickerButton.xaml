<UserControl x:Class="Calligraphy.Presentation.Views.Controls.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Button x:Name="ColorButton"
            Width="85"
            Height="85"
            Cursor="Hand"
            Click="ColorButton_Click">
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Button.Style>

        <Grid>
            <Image x:Name="ButtonImage" Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="/Resources/Assets/Images/Buttons/Button.png"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                                <Setter Property="Source" Value="/Resources/Assets/Images/Buttons/Pressed/Button-pressed.png"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="#755679" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <Ellipse x:Name="ColorCircle"
                     Fill="{Binding ElementName=Root, Path=PencilColor}"
                     Width="38"
                     Height="38"
                     Stroke="#755679"
                     StrokeThickness="2"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, ElementName=Root}" Value="True">
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
    </Button>
</UserControl>