        <Canvas Width="1200" Height="800">

            <!-- PEAK 0  baseX=100 -->

            <Image Source="/Resources/Assets/Images/Themes/Mountain/terrain_snow_ramp_short_b.png"
                   Canvas.Left="100" Canvas.Top="430" Width="42" Height="150" Stretch="Fill">
