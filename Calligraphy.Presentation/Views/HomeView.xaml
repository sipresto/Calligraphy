<UserControl x:Class="Calligraphy.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:local="clr-namespace:Calligraphy.Presentation.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Assets/Images/Background/Background_Blue.png" 
                        Stretch="UniformToFill"/>
        </Grid.Background>
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,50">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
                <Image Source="/Views/Assets/Images/TextBars/Small-bar.png" 
                       Stretch="Uniform"
                       Width="300" />
    
                <TextBlock Text="Cally" 
                           FontFamily="./Assets/Fonts/#Gluten Medium"
                           FontSize="60" 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                </TextBlock>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"> 
            <Button Command="{Binding PlayCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Margin="10"
                    Cursor="Hand"
                    Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Image Source="/Views/Assets/Images/Buttons/Grass-button.png" 
                               Width="60" 
                               Stretch="Uniform" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Command="{Binding PlayCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Margin="10"
                    Cursor="Hand"
                    Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Image Source="/Views/Assets/Images/Buttons/Grass-button.png" 
                               Width="60" 
                               Stretch="Uniform" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
                <Button Command="{Binding PlayCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        Margin="10"
                        Cursor="Hand"
                        Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Image Source="/Views/Assets/Images/Buttons/Grass-button.png" 
                                   Width="60" 
                                   Stretch="Uniform" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>