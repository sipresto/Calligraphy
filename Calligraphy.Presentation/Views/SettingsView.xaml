<UserControl x:Class="Calligraphy.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ImageButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <Grid>
                                <Image x:Name="NormalImage"
                                       Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" 
                                       Stretch="Uniform"/>
                                <Image x:Name="PressedImage"
                                       Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                       Visibility="Collapsed" 
                                       Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NormalImage" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PressedImage" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <Border Width="620" Height="520"
                Background="{StaticResource SecondaryColor}" 
                CornerRadius="50"
                Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4"/>
            </Border.Effect>

            <Border CornerRadius="40" Background="{StaticResource 'PrimaryColor'}" Margin="0,0,0,8">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Kies de kleur van jouw pen!"
                               FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                               FontSize="30"
                               Foreground="{StaticResource SecondaryColor}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ColorPanel" 
                                   HorizontalAlignment="Center" 
                                   Orientation="Horizontal"/>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ImageButtonStyle}"
                            Width="65" Height="65"
                            Margin="0,15,0,5"
                            Tag="/Resources/Assets/Images/Buttons/Buttons-x.png"
                            Content="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-x.png"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>