<UserControl x:Class="Calligraphy.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:Calligraphy.Presentation.Styles"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls">
    
    <Grid Background="{StaticResource BackgroundColor}">
        <Border Width="620" Height="520"
                Background="{StaticResource SecondaryColor}" 
                CornerRadius="50"
                Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4"/>
            </Border.Effect>

            <Border CornerRadius="40" Background="{StaticResource 'PrimaryColor'}" Margin="0,0,0,8">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Kies de kleur van jouw pen!"
                               FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                               FontSize="30"
                               Foreground="{StaticResource SecondaryColor}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableColors}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ColorPickerButton
                                        PencilColor="{Binding Brush}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        Margin="10"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SelectColorCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource ImageButtonStyle}"
                            Width="65" Height="65"
                            Margin="0,15,0,5"
                            styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-x.png"
                            styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-x.png" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>