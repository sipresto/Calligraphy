<Window x:Class="Calligraphy.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Calligraphy.Presentation.ViewModels"
        xmlns:views="clr-namespace:Calligraphy.Presentation.Views"
        Title="Cally" Height="800" Width="1200"
        MinWidth="900"
        MinHeight="600"
        WindowState="Maximized">

    <Window.Background>
        <ImageBrush ImageSource="/Resources/Assets/Images/Backgrounds/Background_Blue.png"
                    Stretch="UniformToFill" />
    </Window.Background>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:InfinityRaceViewModel}">
            <views:InfinityRaceView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type local:TraceGameViewModel}">
            <views:TraceGameView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TimedTraceGameViewModel}">
            <views:TraceGameView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ShapeDrawViewModel}">
            <views:ShapeDrawView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type local:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TutorialViewModel}">
            <views:TutorialView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CategoryViewModel}">
            <views:CategoryView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type local:LevelViewModel}">
            <views:LevelView />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>

</Window>