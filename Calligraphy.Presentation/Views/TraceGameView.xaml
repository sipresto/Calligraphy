<UserControl x:Class="Calligraphy.Presentation.Views.TraceGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             xmlns:themes="clr-namespace:Calligraphy.Presentation.Views.themes"
             xmlns:repeatingTraces="clr-namespace:Calligraphy.Domain.TraceTemplates.RepeatingTraces;assembly=Calligraphy.Domain"
             xmlns:converters="clr-namespace:Calligraphy.Presentation.Converters"
             xmlns:styles="clr-namespace:Calligraphy.Presentation.Styles"
             xmlns:traceTemplates="clr-namespace:Calligraphy.Domain.TraceTemplates;assembly=Calligraphy.Domain"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:TimedTraceGameViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:StrokePointsToGeometryConverter x:Key="StrokeToGeometry" GapThreshold="40" />
        <DataTemplate DataType="{x:Type repeatingTraces:HedgePattern}">
            <themes:HedgeThemeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type repeatingTraces:WavePattern}">
            <themes:WaveThemeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type repeatingTraces:CastleWallPattern}">
            <themes:CastleThemeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type repeatingTraces:LoopPattern}">
            <themes:LoopThemeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type repeatingTraces:MountainPattern}">
            <themes:MountainThemeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type traceTemplates:TraceTemplate}">
            <Grid />
        </DataTemplate>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1200" Height="800" Background="Transparent">
            
            <ContentControl x:Name="ThemeHost"
                            Content="{Binding CurrentTemplate}"
                            Grid.ColumnSpan="2"
                            IsHitTestVisible="False"/>

            <Grid>
                <Path IsHitTestVisible="False"
                      Data="{Binding TemplatePoints, Converter={StaticResource StrokeToGeometry}}"
                      StrokeThickness="{Binding TemplateThickness}"
                      Stroke="{StaticResource TraceLineColor}"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

                <controls:InkCanvasControl x:Name="InkCanvas"
                                           IsDrawingEnabled="{Binding IsDrawingEnabled}"/>
            </Grid>

            <controls:Timer
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,5,0,0"
                Visibility="{Binding IsTimed, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="240"
                Opacity="0.5"
                Foreground="Red"
                Text="{Binding WaitTimerText}"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" />

            <Button
                Command="{Binding PauseCommand}"
                Width="70"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Style="{StaticResource ImageButtonStyle}"
                styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/pause-button.png"
                styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/pause-button.png"
                Visibility="{Binding IsPauseButtonVisible, Converter={StaticResource BoolToVisibility}}" />

            <controls:GameResultPopup
                x:Name="ResultPopup"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <controls:PausePopup
                x:Name="PausePopup"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <controls:MascotFeedbackControl x:Name="MascotFeedback" />
        </Grid>
    </Viewbox>
</UserControl>