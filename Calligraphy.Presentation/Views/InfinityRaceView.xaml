<UserControl x:Class="Calligraphy.Presentation.Views.InfinityRaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:InfinityRaceViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1200" Height="800" Background="White">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <Image Grid.ColumnSpan="2" 
                   Source="/Resources/Assets/Images/Backgrounds/infinity-race-bg.png" 
                   Stretch="Fill" />
            
            <controls:InkCanvasControl
                x:Name="InkCanvas"
                Grid.Column="0"
                Grid.ColumnSpan="2" />

            <Grid x:Name="LeftCircle" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140">
                <Ellipse Fill="#00C000" />
                <Ellipse Stroke="White" StrokeThickness="16" />
                <Ellipse Stroke="Red" StrokeThickness="16" StrokeDashArray="2 2" />
            </Grid>

            <Grid x:Name="RightCircle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140">
                <Ellipse Fill="#00C000" />
                <Ellipse Stroke="White" StrokeThickness="16" />
                <Ellipse Stroke="Red" StrokeThickness="16" StrokeDashArray="2 2" />
            </Grid>

            <controls:Timer
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,5,0,0" />

            <Path
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Stroke="CornflowerBlue"
                StrokeThickness="8"
                StrokeDashArray="2 2"
                Data="M 600,400 Q 720,335 860,300"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" />

            <Polygon
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Points="0,0 -40,15 -32,0 -40,-15"
                Fill="CornflowerBlue"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Polygon.RenderTransform>
                    <TranslateTransform X="892" Y="303" />
                </Polygon.RenderTransform>
            </Polygon>

            <Ellipse
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="15"
                Height="15"
                Fill="CornflowerBlue"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="80"
                FontSize="160"
                Opacity="0.6"
                Foreground="Red"
                Text="{Binding WaitTimerText}"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" />

            <controls:GameResultPopup
                x:Name="ResultPopup"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <controls:MascotFeedbackControl
                x:Name="MascotFeedback"
                Grid.Column="0"
                Grid.ColumnSpan="2" />

        </Grid>
    </Viewbox>

</UserControl>