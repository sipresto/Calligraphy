<UserControl x:Class="Calligraphy.Presentation.Views.InfinityRaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance viewModels:InfinityRaceViewModel}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid  Width="1200" Height="800" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <controls:InkCanvasControl
                x:Name="InkCanvas"
                Grid.ColumnSpan="2" />

            <Ellipse
                x:Name="LeftCircle"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="120"
                Height="120"
                Fill="Blue" />

            <Ellipse
                x:Name="RightCircle"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="120"
                Height="120"
                Fill="Blue" />

            <TextBlock
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="65"
                Foreground="Red"
                Text="{Binding TimerText}" />

            <Path
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Stroke="CornflowerBlue"
                StrokeThickness="8"
                StrokeDashArray="2 2"
                Data="M 600,400 Q 720,335 860,300"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>
            
            <Polygon
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Points="0,0 -40,15 -32,0 -40,-15"
                Fill="CornflowerBlue"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}">
                <Polygon.RenderTransform>
                    <TranslateTransform X="892" Y="303" />
                </Polygon.RenderTransform>
            </Polygon>
            
            <Ellipse
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="15"
                Height="15"
                Fill="CornflowerBlue"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}" />
            
            <TextBlock
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="240"
                Opacity="0.5"
                Foreground="Red"
                Text="{Binding WaitTimerText}"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>
            
            <controls:GameResultPopup
                x:Name="ResultPopup"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            
            <controls:MascotFeedbackControl
                x:Name="MascotFeedback"
                Grid.Column="0"
                Grid.ColumnSpan="2"/>
            
        </Grid>
    </Viewbox>

</UserControl>