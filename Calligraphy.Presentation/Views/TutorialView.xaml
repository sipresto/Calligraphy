<UserControl x:Class="Calligraphy.Presentation.Views.TutorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:converters="clr-namespace:Calligraphy.Presentation.Converters"
             xmlns:styles="clr-namespace:Calligraphy.Presentation.Styles"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <Border MinWidth="600" MinHeight="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SecondaryColor}"
                CornerRadius="50"
                Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" />
            </Border.Effect>

            <Border CornerRadius="40" Background="{StaticResource PrimaryColor}" Margin="0,0,0,10">
                <Grid Margin="40, 20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" MinWidth="520">

                        <TextBlock
                            Text="Tips"
                            FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                            FontSize="40"
                            FontWeight="Bold"
                            TextAlignment="Center" />

                        <TextBlock
                            Text="{Binding PointsExplanation}"
                            FontFamily="/Resources/Assets/Fonts/#Gluten Light"
                            Margin="0,20,0,0"
                            FontSize="24"
                            MaxWidth="560"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Text="Let op dat je niet te hard of te zacht drukt"
                            FontFamily="/Resources/Assets/Fonts/#Gluten Light"
                            Margin="0,10,0,0"
                            FontSize="24"
                            Visibility="{Binding ShowPressureInfo, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Vertical" Margin="0,20,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:AnimatedStar PlaySound="False" IsFilled="True" Width="40" Height="40" Margin="0,0,5,0" />
                                <controls:AnimatedStar PlaySound="False" IsFilled="False" Width="40" Height="40" Margin="0,0,5,0" />
                                <controls:AnimatedStar PlaySound="False" IsFilled="False" Width="40" Height="40" Margin="0,0,5,0" />
                                <TextBlock
                                    Text="{Binding OneStar}"
                                    FontFamily="/Resources/Assets/Fonts/#Gluten Light"
                                    Margin="10,0,0,0"
                                    FontSize="24"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                <controls:AnimatedStar PlaySound="False"  IsFilled="True" Width="40" Height="40" Margin="0,0,5,0" />
                                <controls:AnimatedStar PlaySound="False"  IsFilled="True" Width="40" Height="40" Margin="0,0,5,0" />
                                <controls:AnimatedStar PlaySound="False"  IsFilled="False" Width="40" Height="40" Margin="0,0,5,0" />
                                <TextBlock
                                    Text="{Binding TwoStars}"
                                    FontFamily="/Resources/Assets/Fonts/#Gluten Light"
                                    Margin="10,0,0,0"
                                    FontSize="24"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                                <controls:AnimatedStar PlaySound="False"  IsFilled="True" Width="40" Height="40" Margin="0,0,5,0" />
                                <controls:AnimatedStar PlaySound="False"  IsFilled="True" Width="40" Height="40" Margin="0,0,5,0" />
                                <controls:AnimatedStar PlaySound="False"  IsFilled="True" Width="40" Height="40" Margin="0,0,5,0" />
                                <TextBlock
                                    Text="{Binding ThreeStars}"
                                    FontFamily="/Resources/Assets/Fonts/#Gluten Light"
                                    Margin="10,0,0,0"
                                    FontSize="24"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="20,60,0,0"
                        Padding="10"
                        Background="{StaticResource SecondaryColor}"
                        CornerRadius="5"
                        VerticalAlignment="Top"
                        Visibility="{Binding ImageSource, Converter={StaticResource NullableToVisibilityConverter}}">

                        <Image Source="{Binding ImageSource}"
                               Height="200"
                               Width="200"
                               Stretch="Fill" />
                    </Border>

                    <StackPanel
                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">

                        <Button Command="{Binding CloseTutorialCommand}"
                                Style="{StaticResource ImageButtonStyle}"
                                Width="65"
                                Margin="0,0,5,0"
                                styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-arrow.png"
                                styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-arrow.png" />

                        <Button Command="{Binding MenuCommand}"
                                Style="{StaticResource ImageButtonStyle}"
                                Width="65"
                                Margin="5,0,0,0"
                                styles:ImageButton.NormalImage="/Resources/Assets/Images/Buttons/Buttons-house.png"
                                styles:ImageButton.PressedImage="/Resources/Assets/Images/Buttons/Pressed/Buttons-pressed-house.png" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>