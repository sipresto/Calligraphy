<UserControl x:Class="Calligraphy.Presentation.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Viewbox Stretch="Uniform">
        <Grid>
            <Border Width="1000" Height="600"
                    Background="#755679" 
                    CornerRadius="50"
                    Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4"/>
            </Border.Effect>

            <Border CornerRadius="40" Background="#FFF9EB" Margin="0,0,0,8">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Wat wil je trainen?"
                               FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                               FontSize="80"
                               Foreground="#755679"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ColorPanel" 
                                   HorizontalAlignment="Center" 
                                   Orientation="Horizontal"/>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button
                            Command="{Binding LetterCategoryCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,50"
                            Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image x:Name="ButtonImage"
                                               Source="/Resources/Assets/Images/TextBars/Square.png"
                                               Height="260"
                                               Width="260"
                                               Stretch="Fill">
                                        </Image>
                                        <TextBlock Text="Letters"
                                                   FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                   FontSize="60"
                                                   Foreground="#755679"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Margin="20"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Command="{Binding ShapeCategoryCommand}"
                            HorizontalAlignment="Center"
                            Margin="30,0,0,50"
                            Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image x:Name="ButtonImage"
                                               Source="/Resources/Assets/Images/TextBars/Square.png"
                                               Height="260"
                                               Width="260"
                                               Stretch="Fill">
                                        </Image>
                                        <TextBlock Text="Vormen"
                                                   FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                   FontSize="60"
                                                   Foreground="#755679"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Margin="20"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button
                            Command="{Binding TraceCategoryCommand}"
                            HorizontalAlignment="Center"
                            Margin="30,0,0,50"
                            Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Image x:Name="ButtonImage"
                                               Source="/Resources/Assets/Images/TextBars/Square.png"
                                               Height="260"
                                               Width="260"
                                               Stretch="Fill">
                                        </Image>
                                        <TextBlock Text="Schetsen"
                                                   FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                   FontSize="60"
                                                   Foreground="#755679"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Margin="20"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>

    </Viewbox>
</UserControl>
