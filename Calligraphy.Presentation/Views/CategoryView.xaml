<UserControl x:Class="Calligraphy.Presentation.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

        <Border Width="1000" Height="700"
                Background="{StaticResource SecondaryColor}"
                CornerRadius="50"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.4" />
            </Border.Effect>

            <Border CornerRadius="40" Background="{StaticResource PrimaryColor}" Margin="0,0,0,8">
                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Wat wil je oefenen?"
                               FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                               FontSize="80"
                               Foreground="{StaticResource SecondaryColor}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,10" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <Button Command="{Binding ChooseCategoryCommand}"
                                CommandParameter="Schetsen"
                                Margin="15,0" Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="210" Height="210" x:Name="Root">

                                        <Image Source="/Resources/Assets/Images/TextBars/Square.png" Stretch="Fill" />


                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="70" />
                                            </Grid.RowDefinitions>

                                            <Viewbox Grid.Row="0" Height="80" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="260" Height="150">
                                                    <Path Stroke="#755679" StrokeThickness="14"
                                                          StrokeDashArray="1 1.5" StrokeDashCap="Round"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 20,100 C 50,20 100,20 130,100 S 210,180 250,100" />
                                                    <Ellipse Fill="#2D232F" Width="24" Height="24" Canvas.Left="8"
                                                             Canvas.Top="88" />
                                                    <Path Fill="#2D232F"
                                                          Data="M 10,0 L 13,7 L 20,7 L 15,12 L 17,19 L 10,15 L 3,19 L 5,12 L 0,7 L 7,7 Z"
                                                          Canvas.Left="240" Canvas.Top="90" />
                                                </Canvas>
                                            </Viewbox>

                                            <TextBlock Grid.Row="1"
                                                       Text="Schetsen"
                                                       FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                       FontSize="40"
                                                       Foreground="{StaticResource SecondaryColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0, 0, 0, 18" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Margin" Value="0,8,0,0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding ChooseCategoryCommand}"
                                CommandParameter="Vormen"
                                Margin="15,0" Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="210" Height="210" x:Name="Root">

                                        <Image Source="/Resources/Assets/Images/TextBars/Square.png" Stretch="Fill" />

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="70" />
                                            </Grid.RowDefinitions>

                                            <Viewbox Grid.Row="0" Height="65" VerticalAlignment="Top"
                                                     Margin="0, 55, 0, 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Fill="#755679" Width="40" Height="40" RadiusX="8"
                                                               RadiusY="8" Margin="8" />
                                                    <Ellipse Fill="#2D232F" Width="42" Height="42" Margin="8" />
                                                    <Path Fill="#755679" Stroke="#755679" StrokeThickness="6"
                                                          StrokeLineJoin="Round"
                                                          Data="M 20,0 L 40,35 L 0,35 Z" Margin="8" />
                                                </StackPanel>
                                            </Viewbox>

                                            <TextBlock Grid.Row="1"
                                                       Text="Vormen"
                                                       FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                       FontSize="40"
                                                       Foreground="{StaticResource SecondaryColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0, 0, 0, 18" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Margin" Value="0,8,0,0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding ChooseCategoryCommand}"
                                CommandParameter="Letters"
                                Margin="15,0" Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="210" Height="210" x:Name="Root">

                                        <Image Source="/Resources/Assets/Images/TextBars/Square.png" Stretch="Fill" />

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="70" />
                                            </Grid.RowDefinitions>

                                            <Viewbox Grid.Row="0" Height="100" VerticalAlignment="Center"
                                                     Margin="0, 30, 0, 0">
                                                <Grid Width="100" Height="100">
                                                    <Path Fill="#755679"
                                                          Data="M 50,0 L 5,95 L 25,95 L 35,75 L 65,75 L 75,95 L 95,95 Z M 50,25 L 60,60 L 40,60 Z"
                                                          Stroke="#755679" StrokeThickness="8" StrokeLineJoin="Round" />
                                                    <Path Stroke="#FFF9EB" StrokeThickness="3"
                                                          StrokeDashArray="2 2" StrokeDashCap="Round"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 50,15 L 20,85 M 50,15 L 80,85 M 35,68 L 65,68" />
                                                </Grid>
                                            </Viewbox>

                                            <TextBlock Grid.Row="1"
                                                       Text="Letters"
                                                       FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                       FontSize="40"
                                                       Foreground="{StaticResource SecondaryColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0, 0, 0, 18" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Margin" Value="0,8,0,0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding ChooseCategoryCommand}"
                                CommandParameter="Woorden"
                                Margin="15,0" Cursor="Pen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="210" Height="210" x:Name="Root">

                                        <Image Source="/Resources/Assets/Images/TextBars/Square.png" Stretch="Fill" />

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="70" />
                                            </Grid.RowDefinitions>

                                            <Viewbox Grid.Row="0" Height="120" VerticalAlignment="Center"
                                                     Margin="0,26,0,0">
                                                <Grid Width="100" Height="100">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="A"
                                                                   FontSize="50"
                                                                   FontWeight="UltraBold"
                                                                   Foreground="#755679"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                                   Text="C"
                                                                   FontSize="50"
                                                                   FontWeight="UltraBold"
                                                                   Foreground="#755679"
                                                                   Margin="0,-20,0,0" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                                   Text=" B"
                                                                   FontSize="50"
                                                                   FontWeight="UltraBold"
                                                                   Foreground="#755679" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                                   Text=" D"
                                                                   FontSize="50"
                                                                   FontWeight="UltraBold"
                                                                   Foreground="#755679"
                                                                   Margin="0,-20,0,0" />
                                                    </Grid>
                                                </Grid>
                                            </Viewbox>

                                            <TextBlock Grid.Row="1"
                                                       Text="Woorden"
                                                       FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                                       FontSize="40"
                                                       Foreground="{StaticResource SecondaryColor}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       Margin="0, 0, 0, 18" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Margin" Value="0,8,0,0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>

                    <Button Grid.Row="2"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Background="{StaticResource SecondaryColor}"
                            Style="{StaticResource RoundedButtonStyle}">
                        <TextBlock Text="← Terug"
                                   FontFamily="/Resources/Assets/Fonts/#Gluten Medium"
                                   FontSize="28"
                                   Foreground="{StaticResource PrimaryColor}" />
                    </Button>

                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>