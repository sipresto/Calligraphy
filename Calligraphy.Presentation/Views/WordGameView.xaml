<UserControl x:Class="Calligraphy.Presentation.Views.WordGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Calligraphy.Presentation.Views.Controls"
             xmlns:viewModels="clr-namespace:Calligraphy.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:WordGameViewModel}">
    <Viewbox Stretch="Uniform">
        <Grid Width="1200" Height="800" Background="White">
            
            <Image Grid.ColumnSpan="2" 
                   Source="/Resources/Assets/Images/WordBackgrounds/farm.png" 
                   Stretch="Fill" />
            
            <controls:GameResultPopup
                x:Name="ResultPopup"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <controls:MascotFeedbackControl
                x:Name="MascotFeedback"
                Grid.Column="0"
                Grid.ColumnSpan="2" />

        </Grid>
    </Viewbox>
</UserControl>
